{
  "benches": ["A1", "B1"],
  "unit": "kN",
  "cases": [
    {
      "batch_id": "LC-switch-limit",
      "a_rows": [[0, 1, 0], [1, 2, 2], [2, 3, 4]],
      "b_rows": [[0, 1, 0], [1, 2, 4]],
      "request": {"cut": 1, "before_window": [0, 1], "after_window": [0, 1], "max_change": "1/2", "minimum_coverage": 2},
      "expected": {"minimum_mse": "1", "hulls": [[[0, "1/2"], ["1/2", 1]]]}
    },
    {
      "batch_id": "LC-split-coverage",
      "a_rows": [[0, 1, 0], [2, 3, 0]],
      "b_rows": [[0, 2, 0]],
      "request": {"cut": 1, "before_window": [0, 1], "after_window": [0, 1], "max_change": "1/2", "minimum_coverage": "3/2"},
      "expected": {"minimum_mse": "0", "hulls": [[[0, "1/2"], ["1/2", 1]]]}
    },
    {
      "batch_id": "LC-separated",
      "a_rows": [[0, 2, 0], [3, 5, 0]],
      "b_rows": [[0, 2, 0]],
      "request": {"cut": 1, "before_window": [0, 3], "after_window": [0, 3], "max_change": 0, "minimum_coverage": 2},
      "expected": {"minimum_mse": "0", "hulls": [[[0, 0]], [[3, 3]]]}
    },
    {
      "batch_id": "LC-flat",
      "a_rows": [[0, 3, 0]],
      "b_rows": [[0, 2, 0]],
      "request": {"cut": 1, "before_window": [0, 1], "after_window": [0, 1], "max_change": "1/2", "minimum_coverage": 2},
      "expected": {"minimum_mse": "0", "hulls": [[[0, 0], [0, "1/2"], ["1/2", 1], [1, 1]]]}
    },
    {
      "batch_id": "LC-weighted",
      "a_rows": [[0, 3, 0]],
      "b_rows": [[0, 1, 0], [1, 3, 3]],
      "request": {"cut": 1, "before_window": [0, 0], "after_window": [0, 0], "max_change": 0, "minimum_coverage": 3},
      "expected": {"minimum_mse": "6", "hulls": [[[0, 0]]]}
    },
    {
      "batch_id": "LC-one-side",
      "a_rows": [[0, 1, 0]],
      "b_rows": [[0, 1, 0], [1, 3, 3]],
      "request": {"cut": 1, "before_window": [0, 0], "after_window": [0, 0], "max_change": 0, "minimum_coverage": 1},
      "expected": {"minimum_mse": "0", "hulls": [[[0, 0]]]}
    }
  ]
}
